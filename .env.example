# Generate your local .env with scripts/bootstrap.ps1. Never commit it.
APP_ENV=development
DATABASE_URL=sqlite:///./data/company.db
JWT_SECRET=replace-with-at-least-32-random-characters
PROVIDER_SECRET_KEY=replace-with-base64-encoded-32-byte-key
OWNER_EMAIL=owner@local.test
OWNER_PASSWORD=replace-with-a-long-unique-password
DB_PASSWORD=replace-with-a-database-password
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
MOCK_ENABLED=true
EXECUTION_ENABLED=false
LOGIN_WINDOW_SECONDS=60
LOGIN_ACCOUNT_LIMIT=10
LOGIN_SOURCE_LIMIT=100
WORKER_STALE_SECONDS=90
ARTIFACT_ROOT=./artifacts
REPOSITORY_ROOT=./data/repositories
PROVIDER_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com,api.x.ai,localhost,127.0.0.1
RESEARCH_ALLOWED_HOSTS=cloud.google.com,lightning.ai,aws.amazon.com,azure.microsoft.com
# Environment credentials are optional fallbacks for the encrypted provider vault.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# Production OIDC bearer validation; browser OIDC login is a future milestone.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Optional object storage. Keep buckets private.
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
